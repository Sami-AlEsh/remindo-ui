{
  "name": "remindo-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:zip": "pnpm build && node scripts/netlify-redirects.mjs && rm -f remindo-ui-netlify.zip && cd dist && zip -qr ../remindo-ui-netlify.zip . && cd .. && echo 'remindo-ui-netlify.zip ready — drag it onto the Netlify Deploys tab'",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:types": "pnpm dlx openapi-typescript@7 ${VITE_API_TARGET:-http://localhost:3000}/docs-json -o src/api/schema.d.ts",
    "release": "pnpm build && API_ORIGIN=https://remindo-api.duckdns.org node scripts/netlify-redirects.mjs && cd dist && rm -f ../remindo-ui-netlify.zip && zip -qr ../remindo-ui-netlify.zip . && echo 'zip ready: remindo-ui-netlify.zip — drag it onto Netlify → Deploys'",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
